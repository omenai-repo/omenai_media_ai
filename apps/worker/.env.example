# Copy to apps/worker/.env for `pnpm --filter @repo/worker dev:trigger` (the CLI loads it).
# In deployed environments, set these in the Trigger.dev dashboard (Project → Environment variables).
# The CLI itself authenticates with `npx trigger.dev@latest login`, not with a variable here.

# Same database as the web app (app-only readWrite user). Atlas Network Access must admit
# Trigger.dev's egress (see docs/ARCHITECTURE_DECISIONS.md, ADR-018).
MONGODB_URI=
MONGODB_DB_NAME=omenai

# --- LLM provider (ADR-016) -----------------------------------------------------------------
# gemini for development and testing; anthropic before production.
LLM_PROVIDER=gemini
# Only the active provider's key is required.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model overrides per tier (defaults: packages/core/src/llm/config.ts).
# GEMINI_MODEL_TRIAGE=gemini-3.5-flash-lite
# GEMINI_MODEL_PRIMARY=gemini-3.8-flash
# GEMINI_MODEL_ESCALATION=gemini-3.8-flash
# ANTHROPIC_MODEL_TRIAGE=claude-haiku-5-5
# ANTHROPIC_MODEL_PRIMARY=claude-sonnet-5-5
# ANTHROPIC_MODEL_ESCALATION=claude-opus-5-5

# --- Web search and extraction (Tavily) ------------------------------------------------------
TAVILY_API_KEY=
