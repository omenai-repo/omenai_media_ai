# Copy to apps/worker/.env for `pnpm --filter @repo/worker dev:trigger` (the CLI loads it).
# In deployed environments, set these in the Trigger.dev dashboard (Project → Environment variables).
# The CLI itself authenticates with `npx trigger.dev@latest login`, not with a variable here.

# --- Runtime (required) -------------------------------------------------------------------
# live-dev: real Atlas/Gemini/Tavily/Trigger.dev development, within daily limits (local default).
# fixtures: scripted answers and fake search for UI work (use with MONGODB_DB_NAME=omenai_fixtures).
# production: the deployed app. Must be the same in apps/web/.env.local and apps/worker/.env.
OMENAI_RUNTIME=live-dev

# Same database as the web app (app-only readWrite user). Atlas Network Access must admit
# Trigger.dev's egress (see docs/ARCHITECTURE_DECISIONS.md, ADR-018).
MONGODB_URI=
MONGODB_DB_NAME=omenai_live_dev

# --- LLM provider (ADR-016) -----------------------------------------------------------------
# gemini for development and testing; anthropic before production.
LLM_PROVIDER=gemini
# Only the active provider's key is required.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model overrides per tier (defaults: packages/core/src/llm/config.ts).
# GEMINI_MODEL_TRIAGE=gemini-3.5-flash-lite
# GEMINI_MODEL_PRIMARY=gemini-3.8-flash
# GEMINI_MODEL_ESCALATION=gemini-3.8-flash
# ANTHROPIC_MODEL_TRIAGE=claude-haiku-5-5
# ANTHROPIC_MODEL_PRIMARY=claude-sonnet-5-5
# ANTHROPIC_MODEL_ESCALATION=claude-opus-5-5

# --- Web search and extraction (Tavily) ------------------------------------------------------
TAVILY_API_KEY=

# --- Discovery limits (optional) ----------------------------------------------------------
# Conservative defaults keep API spend low. Every variable and default is listed in
# packages/core/src/discovery/config.ts, e.g. DISCOVERY_MAX_QUERIES=10, DISCOVERY_MAX_EVALUATIONS=25,
# AI_MAX_ESCALATIONS_PER_RUN=4, SHORTLIST_MAX=8, DISCOVERY_LANGUAGES=en.

# --- Live-development limits (required when OMENAI_RUNTIME=live-dev) -------------------------
# Hard caps over a rolling 24 hours, checked before every real request (docs/LIVE_DEVELOPMENT.md).
AI_DAILY_CALL_LIMIT=60
SEARCH_DAILY_CREDIT_LIMIT=20
# A small discovery run for development (defaults are larger; see discovery/config.ts).
DISCOVERY_MAX_QUERIES=3
DISCOVERY_RESULTS_PER_QUERY=5
DISCOVERY_MAX_EXTRACT=12
DISCOVERY_MAX_REVISITS=0
DISCOVERY_MAX_EVALUATIONS=5
AI_MAX_ESCALATIONS_PER_RUN=1
