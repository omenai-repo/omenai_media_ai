# Copy to apps/web/.env.local for local development. Never commit real values.
#
# Variables without the NEXT_PUBLIC_ prefix are only available on the server. Anything prefixed
# with NEXT_PUBLIC_ is inlined into the browser bundle, so never put secrets there.
# A missing required variable fails with a ConfigError naming it (the app still builds).
# The web app calls a model only for chat replies, which it streams itself (ADR-035); research,
# drafts and discovery run in the worker. Search keys belong to the worker only.

# --- Runtime (required) -------------------------------------------------------------------
# live-dev: real Atlas/Gemini/Tavily/Trigger.dev development, within daily limits (local default).
# fixtures: scripted answers and fake search for UI work (use with MONGODB_DB_NAME=omenai_fixtures).
# production: the deployed app. Must be the same in apps/web/.env.local and apps/worker/.env.
OMENAI_RUNTIME=live-dev

# --- Database (MongoDB Atlas) -------------------------------------------------------------
# Atlas connection string for an app-only user with readWrite on the database below.
# Atlas is a replica set, which sign-up requires (it uses transactions).
MONGODB_URI=
# Database name inside the cluster. Required (never assumed); must match OMENAI_RUNTIME:
# live-dev → ends in _dev, fixtures → ends in _fixtures, production → neither. Same in both apps.
MONGODB_DB_NAME=omenai_live_dev

# --- Authentication (Better Auth, email + password, invite-only) ----------------------------
# Random secret, at least 32 characters: `openssl rand -base64 32`. Unique per environment.
BETTER_AUTH_SECRET=
# Public base URL of this app, no trailing slash. Local: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# --- Background jobs (Trigger.dev) ------------------------------------------------------------
# Secret key for the environment (Trigger.dev dashboard → API keys). Live development requires a
# development key (tr_dev_…); production requires tr_prod_…. Checked by prefix before any trigger.
TRIGGER_SECRET_KEY=

# --- AI for chat replies (server-only) ---------------------------------------------------------
# Must match apps/worker/.env: same provider, key, models and daily limits (pnpm env:check
# compares them). Both apps count against the same usage records.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_MODEL_PRIMARY=gemini-3.5-flash-lite
# GEMINI_MODEL_ESCALATION=gemini-3.5-flash-lite
AI_DAILY_CALL_LIMIT=60
SEARCH_DAILY_CREDIT_LIMIT=20

# --- Email (Resend) — optional ---------------------------------------------------------------
# Sends invitation and password-reset emails. Without these, invitation links are shown once to
# the owner to copy and send manually, and password reset is unavailable.
RESEND_API_KEY=
EMAIL_FROM=
