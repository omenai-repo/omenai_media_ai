{
  "$schema": "https://json.schemastore.org/tsconfig",
  "$comment": "Next.js applications: bundler resolution and DOM types; Next.js compiles the output. Extend together with the root tsconfig.base.json.",
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "plugins": [{ "name": "next" }]
  }
}
